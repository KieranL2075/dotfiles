! X colors.
! Generated by 'wal'
*foreground:        #e1cec2
*background:        #0B1118
*.foreground:       #e1cec2
*.background:       #0B1118
emacs*foreground:   #e1cec2
emacs*background:   #0B1118
URxvt*foreground:   #e1cec2
XTerm*foreground:   #e1cec2
UXTerm*foreground:  #e1cec2
URxvt*background:   [100]#0B1118
XTerm*background:   #0B1118
UXTerm*background:  #0B1118
URxvt*cursorColor:  #e1cec2
XTerm*cursorColor:  #e1cec2
UXTerm*cursorColor: #e1cec2
URxvt*borderColor:  [100]#0B1118

! Colors 0-15.
*.color0: #0B1118
*color0:  #0B1118
*.color1: #5E535B
*color1:  #5E535B
*.color2: #A56046
*color2:  #A56046
*.color3: #9A6C60
*color3:  #9A6C60
*.color4: #B7866C
*color4:  #B7866C
*.color5: #D29674
*color5:  #D29674
*.color6: #777285
*color6:  #777285
*.color7: #e1cec2
*color7:  #e1cec2
*.color8: #9d9087
*color8:  #9d9087
*.color9: #5E535B
*color9:  #5E535B
*.color10: #A56046
*color10:  #A56046
*.color11: #9A6C60
*color11:  #9A6C60
*.color12: #B7866C
*color12:  #B7866C
*.color13: #D29674
*color13:  #D29674
*.color14: #777285
*color14:  #777285
*.color15: #e1cec2
*color15:  #e1cec2

! Black color that will not be affected by bold highlighting.
*.color66: #0B1118
*color66:  #0B1118

! Xclock colors.
XClock*foreground: #e1cec2
XClock*background: #0B1118
XClock*majorColor:  rgba:e1/ce/c2/ff
XClock*minorColor:  rgba:e1/ce/c2/ff
XClock*hourColor:   rgba:e1/ce/c2/ff
XClock*minuteColor: rgba:e1/ce/c2/ff
XClock*secondColor: rgba:e1/ce/c2/ff

! Set depth to make transparency work.
URxvt*depth: 32
